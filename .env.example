# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://oddhound:oddhound_local_dev@127.0.0.1:55433/oddhound
# Use an absolute path: the web app and the worker run from different working directories.
ARTIFACT_DIR=/absolute/path/to/claude/.data/artifacts

# Meta model access (primary profile). Leave empty to keep live runs blocked.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low

# Local lab: the demo target runs in containers on an isolated Docker network (172.30.77.0/24).
# The browser container's proxy may reach exactly these endpoints. Never set in production.
ODDHOUND_LAB_MODE=1
ODDHOUND_LAB_ENDPOINTS=172.30.77.10:4310,172.30.77.11:4311
DEMO_TARGET_ORIGIN=http://172.30.77.10:4310
DEMO_TARGET_FIXED_ORIGIN=http://172.30.77.11:4311
# Host-published admin URLs for the lab reset hook (tests only).
DEMO_TARGET_ADMIN_URL=http://127.0.0.1:4320
DEMO_TARGET_FIXED_ADMIN_URL=http://127.0.0.1:4321
ODDHOUND_FIXTURE_RESET_TOKEN=local-lab-reset
# Worker-reachable reset hooks; the worker resets the shared demo target before each demo run/retest.
DEMO_TARGET_RESET_URL=http://127.0.0.1:4320/__lab/reset
DEMO_TARGET_FIXED_RESET_URL=http://127.0.0.1:4321/__lab/reset

# Browser runtime: docker (fresh oddhound-browser container per run), fly (fresh Machine per run),
# or host (debug only; host antivirus can inject into pages).
BROWSER_RUNTIME=docker
BROWSER_IMAGE=oddhound-claude-browser:dev
LAB_NETWORK=oddhound-claude-lab
SECCOMP_PROFILE=infra/docker/playwright-seccomp-profile.json
FLY_API_TOKEN=
FLY_BROWSER_APP=oddhound-browser
FLY_BROWSER_IMAGE=
FLY_REGION=sin

# Auth: GitHub OAuth app for production sign-in. Local dev sign-in only works when ODDHOUND_DEV_LOGIN=1 and NODE_ENV != production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3310
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ODDHOUND_DEV_LOGIN=1
